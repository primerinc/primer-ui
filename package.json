{
  "name": "@primer-inc/ui",
  "version": "0.1.0",
  "description": "Primer shared component library for Astro + Storyblok client builds",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:tokens": "node tokens/sync-from-studio.js",
    "build:tokens": "npm run sync:tokens && style-dictionary build --config tokens/sd.config.js",
    "build:tokens:wireframe": "npm run sync:tokens && PRIMER_THEME=wireframe style-dictionary build --config tokens/sd.config.js",
    "watch:tokens": "style-dictionary build --watch --config tokens/sd.config.js",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:contrast": "node tokens/check-contrast.js",
    "check:storyblok-drift": "node --env-file=.env storyblok/check-drift.js",
    "check:build-safety": "node storyblok/check-build-safety.js",
    "check:storyblok-variants": "node --env-file=.env storyblok/check-variant-css.js",
    "storyblok:render-check": "node --env-file=.env storyblok/render-check.js",
    "bootstrap:client-space": "node --env-file=.env storyblok/bootstrap-client-space.js",
    "storyblok:generate-alt-text": "node --env-file=.env storyblok/generate-alt-text.js"
  },
  "keywords": [
    "astro",
    "storyblok",
    "design-tokens",
    "component-library"
  ],
  "author": "Primer <hello@primerinc.com>",
  "dependencies": {
    "@astrojs/node": "^10.1.4",
    "@storyblok/astro": "^9.0.12",
    "astro": "^6.4.6",
    "style-dictionary": "^5.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3",
    "vite-plugin-mkcert": "^1.17.12"
  },
  "overrides": {
    "vite": "^7"
  }
}
