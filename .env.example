# Copy this file to .env and fill in your values.
# The token below is the same space used in primer-hero-spike — copy it from that project's .env.
STORYBLOK_TOKEN=

# Storyblok Management API token (space Settings → Access Tokens → Management API).
# Used by every storyblok/*.js script (check-drift, check-variant-css, bootstrap-client-space,
# generate-alt-text, etc.) — none of those are the CDN token above.
STORYBLOK_MANAGEMENT_TOKEN=

# Your own Anthropic API key (console.anthropic.com) — used only by
# storyblok/generate-alt-text.js to generate alt text via Claude's vision
# capability. Not required for anything else in this repo.
ANTHROPIC_API_KEY=
