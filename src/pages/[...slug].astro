---
import { useStoryblokApi } from '@storyblok/astro';
import type { SbBlokData } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const api = useStoryblokApi();
  const { data } = await api.get('cdn/stories', {
    version: 'draft',
    excluding_slugs: 'home,config',
  });

  return data.stories.map((story: { full_slug: string; name: string; content: Record<string, unknown> }) => ({
    params: { slug: story.full_slug },
    props: { story },
  }));
}

interface Metatags {
  title?: string;
  description?: string;
  og_image?: string;
}

interface SeoBlock extends SbBlokData {
  metatags?: Metatags;
  canonical_url?: string;
  noindex?: boolean;
}

interface Story {
  name: string;
  content: SbBlokData & {
    seo?: SeoBlock[];
    hide_nav?: boolean;
    hide_footer?: boolean;
  };
}

const { story } = Astro.props as { story: Story };
const seo = story.content.seo?.[0];
const metatags = seo?.metatags;
---

<BaseLayout
  title={metatags?.title || story.name}
  description={metatags?.description}
  ogImage={metatags?.og_image}
  noIndex={seo?.noindex}
  canonicalUrl={seo?.canonical_url}
  hideNav={story.content.hide_nav}
  hideFooter={story.content.hide_footer}
>
  <StoryblokComponent blok={story.content} />
</BaseLayout>
