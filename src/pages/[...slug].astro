---
import { useStoryblokApi } from '@storyblok/astro';
import type { SbBlokData } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const api = useStoryblokApi();
  const { data } = await api.get('cdn/stories', {
    version: 'draft',
    excluding_slugs: 'home',
  });

  return data.stories.map((story: { full_slug: string; name: string; content: Record<string, unknown> }) => ({
    params: { slug: story.full_slug },
    props: { story },
  }));
}

interface Seo {
  title?: string;
  description?: string;
  og_image?: string;
}

interface Story {
  name: string;
  content: SbBlokData & {
    seo?: Seo;
    canonical_url?: string;
    noindex?: boolean;
    hide_nav?: boolean;
    hide_footer?: boolean;
  };
}

const { story } = Astro.props as { story: Story };
const seo = story.content.seo;
---

<BaseLayout
  title={seo?.title || story.name}
  description={seo?.description}
  ogImage={seo?.og_image}
  noIndex={story.content.noindex}
  canonicalUrl={story.content.canonical_url}
  hideNav={story.content.hide_nav}
  hideFooter={story.content.hide_footer}
>
  <StoryblokComponent blok={story.content} />
</BaseLayout>
