---
/**
 * Button
 * Storyblok block name: button
 *
 * Fields: text, link (Multilink), variant (primary | secondary | text | link)
 */
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;

const href = blok.link?.url || blok.link?.cached_url || '#';
const variant = blok.variant || 'primary';
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`]}
  {...storyblokEditable(blok)}
>
  {blok.text}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--p-space-3) var(--p-space-8);
    border-radius: var(--p-radius-button);
    font-family: var(--p-font-body);
    font-size: var(--p-font-size-sm);
    font-weight: var(--p-font-weight-medium);
    letter-spacing: var(--p-font-tracking-wide);
    text-decoration: none;
    transition: opacity var(--p-motion-base) var(--p-motion-ease);
  }

  .btn:hover { opacity: 0.85; }

  .btn--primary {
    background: var(--p-color-accent-default);
    color: var(--p-color-text-on-accent);
  }

  .btn--secondary {
    background: transparent;
    color: var(--p-color-text-primary);
    border: var(--p-border-width-default) solid var(--p-color-border-default);
  }

  /* Same padding/border-width as the other variants (border just goes
     transparent rather than being removed) so it sits level in a row next
     to primary/secondary buttons instead of looking vertically offset. */
  .btn--text {
    background: transparent;
    color: var(--p-color-text-primary);
    border: var(--p-border-width-default) solid transparent;
  }

  .btn--text:hover {
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  /* An underlined arrow-link, not a boxed button — no shared row padding,
     so it sits flush against surrounding copy (e.g. a card's body text)
     rather than looking like a stray button dropped into a paragraph. */
  .btn--link {
    padding: 0;
    background: transparent;
    color: var(--p-color-text-accent-strong);
    border: none;
    border-bottom: var(--p-border-width-default) solid var(--p-color-border-accent);
    border-radius: 0;
  }

  .btn--link:hover { opacity: 0.7; }

  /* Arrow lives in a pseudo-element so it can move without shifting the
     label. translate3d keeps it on the compositor; a plain margin change
     would reflow. */
  .btn--link::after {
    content: '\2192';
    display: inline-block;
    margin-left: 0.4em;
    transition: transform var(--p-motion-base) var(--p-motion-ease);
  }

  .btn--link:hover::after,
  .btn--link:focus-visible::after {
    transform: translate3d(0.22em, 0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn--link::after { transition: none; }
    .btn--link:hover::after { transform: none; }
  }
</style>
