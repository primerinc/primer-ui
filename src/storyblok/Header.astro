---
/**
 * Header
 * Storyblok block name: header
 *
 * Fields: announcement_enabled, announcement_text, announcement_link_label,
 *         announcement_link_url, logo, nav_items (→ nav_item), login_enabled,
 *         login_label, login_link, cta_button (→ button, max 1), sticky
 *
 * nav_item fields: label, link, dropdown_groups (→ nav_group),
 *                  featured_panel (→ nav_featured_panel, max 1)
 * nav_group fields: heading, links (→ nav_link)
 * nav_link fields: label, link, icon (optional), description (optional)
 * nav_featured_panel fields: image, heading, description, cta_button (→ button, max 1)
 *
 * Desktop dropdowns open on hover (mouseenter/leave with a short close delay
 * to survive the gap between trigger and panel) as well as click/keyboard —
 * hover is the primary interaction, click/Enter/Escape/outside-click all
 * still work so touch and keyboard users aren't stranded. Panel position
 * flips to right-aligned via JS if it would overflow the viewport's right
 * edge — see the `positionDropdown` script below.
 */
import { storyblokEditable } from '@storyblok/astro';
import { imageSize } from '../lib/storyblok-image';

const { blok } = Astro.props;

const sticky            = blok.sticky ?? true;
const announcementOn    = blok.announcement_enabled ?? false;
const loginOn           = blok.login_enabled ?? false;
const navItems          = blok.nav_items || [];
const ctaButtons        = blok.cta_button || [];
const logoUrl           = blok.logo?.filename;
const logoAlt           = blok.logo?.alt || 'Logo';
const loginHref         = blok.login_link?.url || blok.login_link?.cached_url || '#';
const announcementHref  = blok.announcement_link_url?.url || blok.announcement_link_url?.cached_url || null;
---

{announcementOn && (
  <div class="announcement-bar" data-announcement {...storyblokEditable(blok)}>
    <p class="announcement-bar__text">
      {blok.announcement_text}
      {announcementHref && blok.announcement_link_label && (
        <a href={announcementHref} class="announcement-bar__link">{blok.announcement_link_label}</a>
      )}
    </p>
    <button class="announcement-bar__close" aria-label="Close announcement" data-close-announcement>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
)}

<header
  class:list={['site-header', sticky && 'site-header--sticky']}
  {...storyblokEditable(blok)}
>
  <div class="site-header__inner">

    <a href="/" class="site-header__logo">
      {logoUrl
        ? <img src={`${logoUrl}/m/200x0`} alt={logoAlt} {...imageSize(logoUrl, 200, 0)} />
        : <span class="site-header__logo-text">{logoAlt}</span>
      }
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <ul class="site-nav__list" role="list">
        {navItems.map((item: any, i: number) => {
          const groups = item.dropdown_groups || [];
          const hasDropdown = groups.length > 0;
          const itemHref = item.link?.url || item.link?.cached_url || null;
          const panel = item.featured_panel?.[0];
          const panelImageUrl = panel?.image?.filename;
          const panelCta = panel?.cta_button?.[0];
          const panelCtaHref = panelCta?.link?.url || panelCta?.link?.cached_url;
          return (
            <li class:list={['site-nav__item', hasDropdown && 'site-nav__item--has-dropdown']} {...storyblokEditable(item)}>
              {hasDropdown ? (
                <>
                  <button
                    class="site-nav__trigger"
                    aria-expanded="false"
                    aria-controls={`dropdown-${i}`}
                    data-dropdown-trigger
                  >
                    {item.label}
                    <svg class="site-nav__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <div class="site-nav__dropdown" id={`dropdown-${i}`} role="region" data-dropdown-panel>
                    <div class="site-nav__dropdown-groups" style={`grid-template-columns: repeat(${groups.length}, minmax(15rem, 1fr));`}>
                      {groups.map((group: any) => {
                        const links = group.links || [];
                        return (
                          <div class="nav-group" {...storyblokEditable(group)}>
                            {group.heading && <p class="nav-group__heading">{group.heading}</p>}
                            <ul class="nav-group__list" role="list">
                              {links.map((link: any) => {
                                const href = link.link?.url || link.link?.cached_url || '#';
                                const iconUrl = link.icon?.filename;
                                return (
                                  <li {...storyblokEditable(link)}>
                                    <a href={href} class="nav-group__link">
                                      {iconUrl && (
                                        <img src={`${iconUrl}/m/40x40/filters:quality(85)`} alt="" class="nav-group__link-icon" width="24" height="24" loading="lazy" />
                                      )}
                                      <span class="nav-group__link-text">
                                        <span class="nav-group__link-label">{link.label}</span>
                                        {link.description && <span class="nav-group__link-desc">{link.description}</span>}
                                      </span>
                                    </a>
                                  </li>
                                );
                              })}
                            </ul>
                          </div>
                        );
                      })}
                    </div>

                    {panel && (
                      <div class="nav-featured-panel" {...storyblokEditable(panel)}>
                        {panelImageUrl && (
                          <div class="nav-featured-panel__media" data-blur-up style={`background-image:url('${panelImageUrl}/m/24x0/filters:blur(12)')`}>
                            <img {...imageSize(panelImageUrl, 400, 240)}
                              src={`${panelImageUrl}/m/400x240/filters:quality(85)`}
                              alt=""
                              class="nav-featured-panel__img"
                              loading="lazy"
                            />
                          </div>
                        )}
                        <div class="nav-featured-panel__body">
                          {panel.heading && <p class="nav-featured-panel__heading">{panel.heading}</p>}
                          {panel.description && <p class="nav-featured-panel__desc">{panel.description}</p>}
                          {panelCta?.text && panelCtaHref && (
                            <a href={panelCtaHref} class:list={['btn', `btn--${panelCta.variant || 'primary'}`, 'nav-featured-panel__cta']}>
                              {panelCta.text}
                            </a>
                          )}
                        </div>
                      </div>
                    )}
                  </div>
                </>
              ) : (
                <a href={itemHref || '#'} class="site-nav__link">{item.label}</a>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="site-header__actions">
      {loginOn && (
        <a href={loginHref} class="site-header__login">{blok.login_label || 'Log In'}</a>
      )}
      {ctaButtons.map((btn: any) => (
        <a
          href={btn.link?.url || btn.link?.cached_url || '#'}
          class:list={['btn', `btn--${btn.variant || 'primary'}`]}
          {...storyblokEditable(btn)}
        >
          {btn.text}
        </a>
      ))}
    </div>

    <button class="site-header__hamburger" aria-label="Open menu" aria-expanded="false" data-hamburger>
      <span class="site-header__hamburger-bar"></span>
      <span class="site-header__hamburger-bar"></span>
      <span class="site-header__hamburger-bar"></span>
    </button>

  </div>

  <div class="site-header__mobile-nav" data-mobile-nav aria-hidden="true">
    <ul class="site-mobile-nav__list" role="list">
      {navItems.map((item: any, i: number) => {
        const groups = item.dropdown_groups || [];
        const hasDropdown = groups.length > 0;
        const itemHref = item.link?.url || item.link?.cached_url || null;
        return (
          <li class="site-mobile-nav__item">
            {hasDropdown ? (
              <>
                <button class="site-mobile-nav__trigger" data-mobile-trigger aria-expanded="false">
                  {item.label}
                  <svg class="site-nav__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <div class="site-mobile-nav__sub" hidden>
                  {groups.map((group: any) => {
                    const links = group.links || [];
                    return (
                      <div class="nav-group">
                        {group.heading && <p class="nav-group__heading">{group.heading}</p>}
                        <ul class="nav-group__list" role="list">
                          {links.map((link: any) => {
                            const href = link.link?.url || link.link?.cached_url || '#';
                            const iconUrl = link.icon?.filename;
                            return (
                              <li>
                                <a href={href} class="nav-group__link">
                                  {iconUrl && (
                                    <img src={`${iconUrl}/m/40x40/filters:quality(85)`} alt="" class="nav-group__link-icon" width="24" height="24" loading="lazy" />
                                  )}
                                  <span class="nav-group__link-text">
                                    <span class="nav-group__link-label">{link.label}</span>
                                    {link.description && <span class="nav-group__link-desc">{link.description}</span>}
                                  </span>
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    );
                  })}
                </div>
              </>
            ) : (
              <a href={itemHref || '#'} class="site-mobile-nav__link">{item.label}</a>
            )}
          </li>
        );
      })}
    </ul>
    <div class="site-mobile-nav__footer">
      {loginOn && (
        <a href={loginHref} class="site-header__login">{blok.login_label || 'Log In'}</a>
      )}
      {ctaButtons.map((btn: any) => (
        <a
          href={btn.link?.url || btn.link?.cached_url || '#'}
          class:list={['btn', `btn--${btn.variant || 'primary'}`]}
        >
          {btn.text}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  // Announcement bar close
  document.querySelectorAll('[data-close-announcement]').forEach(btn => {
    btn.addEventListener('click', () => {
      const bar = btn.closest('[data-announcement]') as HTMLElement;
      if (bar) bar.style.display = 'none';
    });
  });

  // Desktop dropdowns — open on hover (primary interaction, matching a
  // mega-menu) as well as click/Enter and keyboard focus, so mouse, touch,
  // and keyboard users are all covered. Close on outside click, Escape, or
  // the mouse leaving the item (with a short delay so moving the cursor
  // from the trigger down into the panel doesn't close it mid-transit).
  const CLOSE_DELAY_MS = 150;
  let closeTimer: ReturnType<typeof setTimeout> | null = null;

  function closeAllDropdowns() {
    document.querySelectorAll('[data-dropdown-trigger]').forEach(t => {
      t.setAttribute('aria-expanded', 'false');
      const item = t.closest('.site-nav__item');
      item?.classList.remove('is-open');
      item?.querySelector('[data-dropdown-panel]')?.classList.remove('align-right');
    });
  }

  function openDropdown(trigger: Element) {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    document.querySelectorAll('[data-dropdown-trigger]').forEach(t => {
      if (t !== trigger) {
        t.setAttribute('aria-expanded', 'false');
        t.closest('.site-nav__item')?.classList.remove('is-open');
      }
    });
    trigger.setAttribute('aria-expanded', 'true');
    const item = trigger.closest('.site-nav__item');
    item?.classList.add('is-open');
    positionDropdown(item as HTMLElement | null);
  }

  function scheduleClose(item: Element | null) {
    if (closeTimer) clearTimeout(closeTimer);
    closeTimer = setTimeout(() => {
      item?.querySelector('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'false');
      item?.classList.remove('is-open');
      item?.querySelector('[data-dropdown-panel]')?.classList.remove('align-right');
    }, CLOSE_DELAY_MS);
  }

  /** Flips the panel to right-aligned if it would overflow the viewport's right edge. */
  function positionDropdown(item: HTMLElement | null) {
    const panel = item?.querySelector<HTMLElement>('[data-dropdown-panel]');
    if (!panel) return;
    panel.classList.remove('align-right');
    const rect = panel.getBoundingClientRect();
    if (rect.right > window.innerWidth - 16) {
      panel.classList.add('align-right');
    }
  }

  document.querySelectorAll('.site-nav__item--has-dropdown').forEach(item => {
    const trigger = item.querySelector('[data-dropdown-trigger]');
    if (!trigger) return;

    item.addEventListener('mouseenter', () => openDropdown(trigger));
    item.addEventListener('mouseleave', () => scheduleClose(item));
    item.addEventListener('focusin', () => openDropdown(trigger));
    item.addEventListener('focusout', (e) => {
      // Only close if focus actually left the item, not just moved between
      // its own children (trigger -> a link inside the panel, etc).
      if (!item.contains((e as FocusEvent).relatedTarget as Node)) scheduleClose(item);
    });

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        trigger.setAttribute('aria-expanded', 'false');
        item.classList.remove('is-open');
      } else {
        openDropdown(trigger);
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.site-nav__item--has-dropdown')) {
      closeAllDropdowns();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
  });

  // Mobile hamburger
  const hamburger = document.querySelector('[data-hamburger]') as HTMLButtonElement;
  const mobileNav = document.querySelector('[data-mobile-nav]') as HTMLElement;
  const header    = document.querySelector('.site-header') as HTMLElement;

  /**
   * The open menu covers the page, so everything behind it is marked inert:
   * that removes it from the tab order and the accessibility tree in one step,
   * which is what keeps focus inside the menu without hand-rolling a trap.
   */
  function setMenu(open: boolean) {
    if (!hamburger) return;

    hamburger.setAttribute('aria-expanded', String(open));
    hamburger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobileNav?.setAttribute('aria-hidden', String(!open));
    header?.classList.toggle('mobile-open', open);

    // Stop the page behind the overlay from scrolling with it.
    document.body.style.overflow = open ? 'hidden' : '';

    ['main-content', 'site-footer'].forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      if (open) el.setAttribute('inert', '');
      else el.removeAttribute('inert');
    });

    // Closing by any route should hand focus back to the control that opened it.
    if (!open) hamburger.focus();
    else mobileNav?.querySelector<HTMLElement>('a, button')?.focus();
  }

  hamburger?.addEventListener('click', () => {
    setMenu(hamburger.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (hamburger?.getAttribute('aria-expanded') === 'true') setMenu(false);
  });

  // Mobile sub-menu toggles
  document.querySelectorAll('[data-mobile-trigger]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const sub = trigger.nextElementSibling as HTMLElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) sub?.setAttribute('hidden', '');
      else sub?.removeAttribute('hidden');
    });
  });
</script>

<style>
  /* ── Announcement Bar ───────────────────────────────────────── */
  .announcement-bar {
    background: var(--p-color-accent-default);
    color: var(--p-color-text-on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--p-space-4);
    padding: var(--p-space-2) var(--p-space-6);
    font-family: var(--p-font-body);
    font-size: var(--p-font-size-sm);
    position: relative;
  }

  .announcement-bar__text { margin: 0; }

  .announcement-bar__link {
    color: inherit;
    font-weight: var(--p-font-weight-medium);
    text-underline-offset: 0.125rem;
    margin-left: var(--p-space-2);
  }

  .announcement-bar__close {
    position: absolute;
    right: var(--p-space-4);
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: var(--p-space-1);
    opacity: 0.75;
    line-height: 1;
  }

  .announcement-bar__close:hover { opacity: 1; }

  /* ── Site Header ────────────────────────────────────────────── */
  .site-header {
    background: var(--p-color-bg-primary);
    border-bottom: var(--p-border-width-default) solid var(--p-color-border-default);
    padding: 0 var(--p-space-6);
    position: relative;
    z-index: 100;
  }

  .site-header--sticky {
    position: sticky;
    top: 0;
  }

  .site-header__inner {
    max-width: var(--p-container-wide);
    margin: 0 auto;
    height: 4.25rem; /* 68px */
    display: flex;
    align-items: center;
    gap: var(--p-space-8);
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .site-header__logo img { display: block; height: 2.25rem; width: auto; } /* 36px */

  .site-header__logo-text {
    font-family: var(--p-font-display);
    font-size: var(--p-font-size-lg);
    font-weight: var(--p-font-weight-semibold);
    color: var(--p-color-text-primary);
  }

  /* ── Desktop Nav ────────────────────────────────────────────── */
  .site-nav { flex: 1; }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--p-space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__item { position: relative; }

  .site-nav__link,
  .site-nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--p-space-1);
    padding: var(--p-space-2) var(--p-space-3);
    font-family: var(--p-font-body);
    font-size: var(--p-font-size-sm);
    font-weight: var(--p-font-weight-medium);
    color: var(--p-color-text-primary);
    text-decoration: none;
    background: none;
    border: none;
    border-radius: var(--p-radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--p-motion-hover) var(--p-motion-ease), color var(--p-motion-hover) var(--p-motion-ease);
  }

  .site-nav__link:hover,
  .site-nav__trigger:hover,
  .site-nav__item--has-dropdown.is-open .site-nav__trigger {
    background: var(--p-color-bg-secondary);
    color: var(--p-color-accent-default);
  }

  .site-nav__chevron {
    transition: transform var(--p-motion-base) var(--p-motion-ease);
    flex-shrink: 0;
  }

  .site-nav__item--has-dropdown.is-open .site-nav__chevron {
    transform: rotate(180deg);
  }

  /* ── Dropdown Panel ─────────────────────────────────────────── */
  .site-nav__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + var(--p-space-2));
    left: 0;
    background: var(--p-color-bg-primary);
    border: var(--p-border-width-default) solid var(--p-color-border-default);
    border-radius: var(--p-radius-card);
    box-shadow: var(--p-shadow-md);
    padding: var(--p-space-6);
    gap: var(--p-space-8);
    /* Viewport-relative, not a fixed guess — the panel is only ever as
       wide as its grid content needs (see .site-nav__dropdown-groups
       below) up to whatever the viewport actually allows. No more fixed
       pixel ceiling to keep in sync with the column sizing. */
    max-width: calc(100vw - var(--p-space-8));
    z-index: 200;
  }

  /* Flipped via JS (positionDropdown) when the panel would otherwise
     overflow the viewport's right edge — items near the end of the nav
     need to hang from their right side instead of their left. */
  .site-nav__dropdown.align-right {
    left: auto;
    right: 0;
  }

  .site-nav__item--has-dropdown.is-open .site-nav__dropdown {
    display: flex;
  }

  /* CSS Grid, not flex — a flex row with a fixed flex-basis per column
     turned into a tug-of-war against .site-nav__dropdown's max-width: every
     time the base column width grew (220px -> 280px -> 340px) the cap had
     to grow to match or flex-shrink silently compressed everything straight
     back down, which is exactly what happened (a column with an icon +
     description compressed hard enough to wrap "Description is here" onto
     3 lines, one word each). `minmax(15rem, 1fr)` gives each column a real
     floor it will never compress past, sharing any extra space equally
     beyond that floor.

     The column COUNT comes from an inline `grid-template-columns` set in
     the template (`repeat(${groups.length}, minmax(15rem, 1fr))`), not
     `auto-fit`. `auto-fit`/`auto-fill` need a *definite* container width to
     compute "how many columns fit" — everything around this element
     (`.site-nav__dropdown`, its `.site-nav__item` ancestor) is
     intrinsically/shrink-to-fit sized with no definite width anywhere, so
     per spec `auto-fit` degenerates to a single column in that context,
     which is exactly what pushed the 2nd group onto its own row. We
     already know the real column count server-side, so there's no need
     for auto-fit's reflow-based guessing at all. */
  .site-nav__dropdown-groups {
    display: grid;
    gap: var(--p-space-8);
    flex: 1 1 auto;
    min-width: 0;
  }

  /* ── Nav Groups ─────────────────────────────────────────────── */
  .nav-group {
    /* Sized entirely by the grid track above — no width/flex properties
       needed here. */
    min-width: 0;
  }

  .nav-group__heading {
    font-family: var(--p-font-body);
    font-size: var(--p-font-size-xs);
    font-weight: var(--p-font-weight-semibold);
    color: var(--p-color-text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--p-font-tracking-wide);
    margin: 0 0 var(--p-space-3);
    padding: 0 var(--p-space-2);
  }

  .nav-group__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--p-space-1);
  }

  .nav-group__link {
    display: flex;
    align-items: flex-start;
    gap: var(--p-space-4);
    padding: var(--p-space-3);
    font-family: var(--p-font-body);
    text-decoration: none;
    border-radius: var(--p-radius-sm);
    transition: background var(--p-motion-hover) var(--p-motion-ease);
  }

  .nav-group__link:hover {
    background: var(--p-color-bg-secondary);
  }

  .nav-group__link-icon {
    flex-shrink: 0;
    margin-top: 0.125rem; /* 2px */
    border-radius: var(--p-radius-sm);
    object-fit: contain;
  }

  .nav-group__link-text {
    display: flex;
    flex-direction: column;
    gap: var(--p-space-1);
    min-width: 0;
  }

  .nav-group__link-label {
    font-size: var(--p-font-size-sm);
    font-weight: var(--p-font-weight-medium);
    color: var(--p-color-text-primary);
    transition: color var(--p-motion-hover) var(--p-motion-ease);
  }

  .nav-group__link:hover .nav-group__link-label {
    color: var(--p-color-accent-default);
  }

  .nav-group__link-desc {
    font-size: var(--p-font-size-xs);
    color: var(--p-color-text-secondary);
    line-height: var(--p-font-leading-normal);
  }

  /* ── Featured Panel ─────────────────────────────────────────── */
  .nav-featured-panel {
