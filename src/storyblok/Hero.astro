---
/**
 * Hero
 * Storyblok block name: hero
 *
 * Fields: headline, subheadline, buttons (Blocks → button), background_image, image, layout
 */
import { storyblokEditable } from '@storyblok/astro';
import { imageSize } from '../lib/storyblok-image';

const { blok } = Astro.props;

const layout = blok.layout || 'centered';
const bg     = blok.background || 'secondary';

const imageUrl = blok.background_image?.filename
  ? `${blok.background_image.filename}/m/1600x0/filters:quality(80)`
  : null;

const heroImageUrl = blok.image?.filename
  ? `${blok.image.filename}/m/1200x0/filters:quality(85)`
  : null;

const buttons = blok.buttons || [];
---

<section
  {...storyblokEditable(blok)}
  class:list={['hero', `hero--${layout}`, `hero--bg-${bg}`]}
  style={imageUrl ? `--hero-bg: url('${imageUrl}')` : ''}
>
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 class="hero__headline">{blok.headline}</h1>
      {blok.subheadline && <p class="hero__sub">{blok.subheadline}</p>}
      {buttons.length > 0 && (
        <div class="hero__actions">
          {buttons.map((btn: any) => (
            <a
              href={btn.link?.url || btn.link?.cached_url || '#'}
              class:list={['btn', `btn--${btn.variant || 'primary'}`]}
              {...storyblokEditable(btn)}
            >
              {btn.text}
            </a>
          ))}
        </div>
      )}
    </div>

    {layout === 'two-column' && heroImageUrl && (
      <div class="hero__media" data-blur-up style={blok.image?.filename ? `background-image:url('${blok.image?.filename}/m/24x0/filters:blur(12)')` : undefined}>
        <img {...imageSize(blok.image?.filename, 1200, 0)}
          src={heroImageUrl}
          alt={blok.image?.alt || ''}
          class="hero__img"
          loading="lazy"
        />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    background-color: var(--p-color-bg-secondary);
    background-image: var(--hero-bg, none);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: var(--p-space-24) var(--p-space-8);
    position: relative;
  }

  .hero--bg-primary       { background-color: var(--p-color-bg-primary); }
  .hero--bg-accent-subtle { background-color: var(--p-color-bg-accent); }
  .hero--bg-dark          { background-color: var(--p-color-bg-inverse); }

  /* Base text/border colors assume a light section background — flip them
     for the dark variant instead of introducing separate light/dark markup. */
  .hero--bg-dark .hero__headline,
  .hero--bg-dark .hero__sub {
    color: var(--p-color-text-on-dark);
  }

  .hero--bg-dark .btn--secondary {
    color: var(--p-color-text-on-dark);
    border-color: var(--p-color-text-on-dark);
  }

  .hero--bg-dark .btn--text {
    color: var(--p-color-text-on-dark);
  }

  .hero__inner {
    max-width: 53.75rem; /* 860px — reading-width measure specific to Hero's centered/left copy, not part of the shared container scale */
    margin: 0 auto;
  }

  .hero--centered .hero__inner {
    text-align: center;
  }

  .hero--two-column .hero__inner {
    max-width: var(--p-container-wide);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--p-space-16);
    align-items: center;
    text-align: left;
  }

  .hero__media {
    border-radius: var(--p-radius-card);
    overflow: hidden;
  }

  .hero__img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .hero--two-column .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--p-space-10);
    }
  }

  .hero__headline {
    font-family: var(--p-font-display);
    font-size: var(--p-font-size-4xl);
    font-weight: var(--p-font-weight-semibold);
    line-height: var(--p-font-leading-tight);
    color: var(--p-color-text-primary);
    margin-bottom: var(--p-space-6);
  }

  .hero__sub {
    font-family: var(--p-font-body);
    font-size: var(--p-font-size-lg);
    font-weight: var(--p-font-weight-light);
    color: var(--p-color-text-secondary);
    max-width: var(--p-container-sm);
    margin-bottom: var(--p-space-10);
  }

  .hero--centered .hero__sub {
    margin-inline: auto;
  }

  .hero__actions {
    display: flex;
    gap: var(--p-space-4);
    flex-wrap: wrap;
  }

  .hero--centered .hero__actions {
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--p-space-3) var(--p-space-8);
    border-radius: var(--p-radius-button);
    font-family: var(--p-font-body);
    font-size: var(--p-font-size-sm);
    font-weight: var(--p-font-weight-medium);
    letter-spacing: var(--p-font-tracking-wide);
    text-decoration: none;
    transition: opacity var(--p-motion-base) var(--p-motion-ease);
  }

  .btn:hover { opacity: 0.85; }

  .btn--primary {
    background: var(--p-color-accent-default);
    color: var(--p-color-text-on-accent);
  }

  .btn--secondary {
    background: transparent;
    color: var(--p-color-text-primary);
    border: var(--p-border-width-default) solid var(--p-color-border-default);
  }
</style>
